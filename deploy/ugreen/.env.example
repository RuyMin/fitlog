GOOGLE_SPREADSHEET_ID=
FITLOG_IMAGE_TAG=latest

# Login (phase 6). HTTPS address users open, e.g. https://fitlog.example.com.
# Unsafe requests from any other Origin are rejected.
FITLOG_PUBLIC_URL=
# Required once when an existing database upgrades to schema v3:
# all existing records are assigned to this (your) Google account email.
FITLOG_OWNER_EMAIL=
# Google login: OAuth client ID ("Web application") and its secret in a config/ file.
# Authorized redirect URI in Google Cloud: ${FITLOG_PUBLIC_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET_FILE=/app/config/google-oauth-client-secret
